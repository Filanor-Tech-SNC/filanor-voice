# ============================================================
# Filanor Voice — Environment Variables
# ============================================================
# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local est git-ignored — NE JAMAIS le committer.
# ============================================================

# --- Retell AI ---
RETELL_API_KEY=
RETELL_AGENT_ID_SALON=
RETELL_AGENT_ID_RESTAURANT=
RETELL_WEBHOOK_SECRET=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_CALLER_ID=+41...

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_SOPHIE=   # ex: voix Charlotte FR
ELEVENLABS_VOICE_ID_MARC=     # ex: voix Antoine FR

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REGION=eu-central-1  # Frankfurt

# --- Google Calendar (via OAuth by tenant, stocké en Supabase) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.filanor.ch/api/oauth/google/callback

# --- App ---
NEXT_PUBLIC_APP_URL=https://app.filanor.ch
NODE_ENV=development
CRON_SECRET=  # protège /api/cron/* — Vercel l'auto-inject sur les crons programmés
